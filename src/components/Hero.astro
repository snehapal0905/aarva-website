---
import { Image } from 'astro:assets';
import { company, heroStats, heroParts } from '../data/content';
import skyDay from '../assets/hero/sky-day.jpg';
import skyDusk from '../assets/hero/sky-dusk.jpg';
import cloudsLeft from '../assets/hero/clouds-left.jpg';
import cloudsRight from '../assets/hero/clouds-right.jpg';
import cloudsLeftBlur from '../assets/hero/clouds-left-blur.jpg';
import cloudsRightBlur from '../assets/hero/clouds-right-blur.jpg';
import plane from '../assets/hero/plane.png';
import puff1 from '../assets/hero/puff-1.png';
import puff2 from '../assets/hero/puff-2.png';
import puff3 from '../assets/hero/puff-3.png';

import bracket from '../assets/hero/part-bracket.png';
import housing from '../assets/hero/part-housing.png';
import block from '../assets/hero/part-block.png';
import spacer from '../assets/hero/part-spacer.png';
import valve from '../assets/hero/part-valve.png';
import panel from '../assets/hero/part-panel.png';

const partImages = [bracket, housing, block, spacer, valve, panel];
// Where each part leaves the plane, as a fraction of the plane image (the plane faces left).
const anchors: Record<string, [number, number]> = {
  wing: [0.5, 0.62],
  fuselage: [0.3, 0.42],
  'engine pylon': [0.42, 0.72],
  'landing gear': [0.56, 0.8],
  'hydraulics bay': [0.64, 0.6],
  tail: [0.9, 0.25],
};
const parts = heroParts.map((p, i) => ({ ...p, img: partImages[i], anchor: anchors[p.from] ?? [0.5, 0.5] }));
const word = company.shortName + ' ' + company.wordmarkSub;
---
<section class="h" data-hero aria-labelledby="hero-title">
  <div class="h-stage">
    <div class="h-sky">
      <Image src={skyDay} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
      <Image src={skyDusk} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="h-dusk" data-dusk />
    </div>

    <div class="h-puffs h-puffs-far" aria-hidden="true">
      <Image src={puff2} alt="" widths={[600, 1100]} sizes="40vw" class="h-puff p2" data-puff="0.6" />
    </div>

    <div class="h-plane" data-plane>
      <span class="h-trail" data-trail aria-hidden="true"></span>
      <Image src={plane} alt="Passenger jet in flight" widths={[900, 1600, 2400]} sizes="(max-width: 768px) 130vw, 75vw" loading="eager" />
    </div>

    <div class="h-puffs h-puffs-near" aria-hidden="true">
      <Image src={puff1} alt="" widths={[900, 1400]} sizes="90vw" class="h-puff p1" data-puff="1.4" />
      <Image src={puff3} alt="" widths={[600, 1100]} sizes="45vw" class="h-puff p3" data-puff="1.1" />
    </div>

    <ul class="h-parts" data-parts>
      {parts.map((p, i) => (
        <li class={`h-part h-part-${i + 1}`} data-part data-ax={p.anchor[0]} data-ay={p.anchor[1]}>
          <div class="h-part-img">
            <Image src={p.img} alt={p.name} widths={[300, 560]} sizes="(max-width: 768px) 30vw, 16vw" />
          </div>
          <span class="h-lead" data-lead aria-hidden="true"></span>
          <p class="h-label" data-label>
            <strong>{p.name}</strong>
            <span>{p.material} · {p.process}</span>
          </p>
        </li>
      ))}
    </ul>

    <div class="h-wall" aria-hidden="true">
      <div class="h-half h-left" data-wall="-1">
        <div class="h-drift">
          <Image src={cloudsLeft} alt="" widths={[900, 1800]} sizes="62vw" loading="eager" fetchpriority="high" />
          <Image src={cloudsLeftBlur} alt="" widths={[900]} sizes="62vw" class="h-blur" data-blur />
        </div>
      </div>
      <div class="h-half h-right" data-wall="1">
        <div class="h-drift">
          <Image src={cloudsRight} alt="" widths={[900, 1800]} sizes="62vw" loading="eager" fetchpriority="high" />
          <Image src={cloudsRightBlur} alt="" widths={[900]} sizes="62vw" class="h-blur" data-blur />
        </div>
      </div>
    </div>

    <div class="h-title" data-title>
      <h1 id="hero-title" aria-label={`${word} ${company.tagline}`}>
        <span class="h-word" aria-hidden="true">
          {word.split(' ').map((w, wi) => (
            <span class="h-w">
              {[...w].map((ch, ci) => <span class="h-ch" style={`--i:${wi * 6 + ci}`}>{ch}</span>)}
            </span>
          ))}
        </span>
        <span class="h-pvt" aria-hidden="true">PVT. LTD.</span>
        <span class="h-tag" aria-hidden="true">{company.tagline}</span>
      </h1>
      <span class="h-scroll" aria-hidden="true"><span>Scroll</span><i></i></span>
    </div>

    <p class="h-line" data-line>Every aircraft is built from thousands of precision parts.</p>

    <div class="h-final" data-final>
      <h2>We machine the parts that make it fly.</h2>
      <dl class="h-stats">
        {heroStats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <div class="h-cta">
        <a href="/capabilities/" class="h-btn h-btn-ghost">Explore Capabilities</a>
        <a href="/contact/#rfq" class="h-btn h-btn-accent">Request a Quote</a>
      </div>
    </div>
  </div>
</section>

<style>
  .h {
    --navy: #0a1020;
    --ink: #07090e;
    --paper: #f3f1ec;
    --orange: #ff5b1f;
    position: relative;
    margin-top: -76px;
    background: var(--ink);
    color: #eef1f6;
  }
  :global(html.js) .h { height: 500vh; }
  .h-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .h-stage > *, .h-sky img, .h-wall { position: absolute; }
  .h-sky, .h-puffs, .h-wall, .h-parts { inset: 0; }
  .h-sky img { inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .h-dusk { opacity: 0; }
  /* A soft scrim keeps the header readable over bright cloud. */
  .h-stage::after {
    content: ''; position: absolute; inset: 0 0 auto; height: 160px; z-index: 9; pointer-events: none;
    background: linear-gradient(rgba(7, 9, 14, 0.55), rgba(7, 9, 14, 0));
  }

  .h-puffs { pointer-events: none; }
  .h-puff { position: absolute; height: auto; will-change: transform; }
  .p1 { width: 95vw; left: -10vw; bottom: -14vh; }
  .p2 { width: 42vw; right: 2vw; top: 18vh; opacity: 0.85; }
  .p3 { width: 48vw; right: -8vw; bottom: 8vh; }

  .h-plane {
    left: 50%; top: 52%;
    width: 75vw;
    will-change: transform, opacity;
  }
  .h-plane img { display: block; width: 100%; height: auto; position: relative; }
  .h-trail {
    position: absolute; left: 88%; top: 52%;
    width: 70vw; height: 0.55vw; min-height: 3px;
    transform-origin: left center; transform: scaleX(0);
    border-radius: 99px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0));
  }

  .h-parts { list-style: none; margin: 0; padding: 0; pointer-events: none; }
  .h-part { position: absolute; width: 12vw; transform: translate(-50%, -50%); opacity: 0; will-change: transform, opacity; }
  .h-part-img img { display: block; width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.45)); }
  .h-part-img { animation: h-float 6s ease-in-out infinite alternate; animation-play-state: paused; }
  :global(.h-settled) .h-part-img { animation-play-state: running; }
  .h-part:nth-child(2n) .h-part-img { animation-delay: -3s; }
  .h-part-1 { left: 12%; top: 29%; }
  .h-part-2 { left: 88%; top: 29%; width: 10vw; }
  .h-part-3 { left: 10%; top: 66%; width: 8vw; }
  .h-part-4 { left: 90%; top: 66%; width: 9vw; }
  .h-part-5 { left: 30%; top: 80%; width: 5vw; }
  .h-part-6 { left: 70%; top: 80%; width: 5vw; }
  .h-lead {
    display: block; width: 1px; height: 28px; margin: 6px auto 0;
    background: rgba(238, 241, 246, 0.7); transform-origin: top; transform: scaleY(0);
  }
  .h-label { margin: 8px 0 0; text-align: center; font-size: 13px; line-height: 1.35; opacity: 0; white-space: nowrap; }
  .h-label strong { display: block; font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .h-label span { color: rgba(238, 241, 246, 0.72); font-variant-numeric: tabular-nums; }

  .h-wall { pointer-events: none; z-index: 5; }
  .h-half { position: absolute; top: 0; bottom: 0; width: 62vw; will-change: transform; }
  .h-left { left: -1vw; -webkit-mask-image: linear-gradient(90deg, #000 72%, transparent); mask-image: linear-gradient(90deg, #000 72%, transparent); }
  .h-right { right: -1vw; -webkit-mask-image: linear-gradient(270deg, #000 72%, transparent); mask-image: linear-gradient(270deg, #000 72%, transparent); }
  .h-drift { position: absolute; inset: -4%; animation: h-drift 14s ease-in-out infinite alternate; }
  .h-right .h-drift { animation-delay: -7s; }
  .h-drift img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .h-blur { opacity: 0; }

  .h-title {
    inset: 0; z-index: 6;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; color: var(--navy); pointer-events: none;
  }
  .h-title h1 { margin: 0; display: flex; flex-direction: column; align-items: center; }
  .h-word { display: flex; gap: 0.28em; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 9.4vw; line-height: 0.92; letter-spacing: -0.035em; }
  .h-w { display: inline-flex; overflow: hidden; padding-bottom: 0.06em; }
  .h-ch { display: inline-block; transform: translateY(105%); animation: h-rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(0.25s + var(--i) * 0.045s); }
  .h-pvt { margin-top: 0.9rem; font-size: 13px; font-weight: 600; letter-spacing: 0.32em; }
  .h-tag { margin-top: 1.6rem; font-family: 'Inter Tight', sans-serif; font-weight: 500; font-size: clamp(20px, 2.2vw, 32px); letter-spacing: -0.015em; }
  .h-pvt, .h-tag { opacity: 0; animation: h-fade 0.9s ease-out 1.1s forwards; }
  .h-scroll {
    position: absolute; bottom: 5vh; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase;
  }
  .h-scroll i { display: block; width: 1px; height: 46px; background: rgba(10, 16, 32, 0.25); position: relative; overflow: hidden; }
  .h-scroll i::after { content: ''; position: absolute; inset: 0; background: var(--navy); transform: translateY(-100%); animation: h-scroll 2s cubic-bezier(0.65, 0, 0.35, 1) infinite; }

  .h-line {
    left: max(24px, 6vw); top: 22%; z-index: 7; margin: 0; max-width: 30ch;
    font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: clamp(26px, 3.2vw, 48px); line-height: 1.05; letter-spacing: -0.03em;
    color: var(--navy); opacity: 0;
  }

  .h-final {
    left: 50%; top: 50%; z-index: 7; width: min(46vw, 640px);
    text-align: center; opacity: 0; visibility: hidden;
  }
  .h-final h2 { margin: 0; font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: clamp(34px, 4.4vw, 68px); line-height: 1; letter-spacing: -0.035em; }
  .h-stats { display: grid; grid-template-columns: repeat(4, auto); justify-content: center; gap: 0 28px; margin: 34px 0 0; padding: 18px 0 0; border-top: 1px solid rgba(238, 241, 246, 0.22); }
  .h-stats div { display: flex; flex-direction: column-reverse; }
  .h-stats dd { margin: 0; font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: clamp(16px, 1.4vw, 21px); color: var(--orange); font-variant-numeric: tabular-nums; }
  .h-stats dt { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(238, 241, 246, 0.66); }
  .h-cta { display: flex; justify-content: center; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .h-btn {
    position: relative; overflow: hidden; display: inline-flex; align-items: center; height: 50px; padding: 0 24px;
    font-weight: 600; font-size: 15px; border-radius: 2px; transition: color 0.35s ease;
  }
  .h-btn::before { content: ''; position: absolute; inset: 0; z-index: -1; transform: scaleX(0); transform-origin: right; transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1); }
  .h-btn:hover::before, .h-btn:focus-visible::before { transform: scaleX(1); transform-origin: left; }
  .h-btn { isolation: isolate; }
  .h-btn-accent { background: var(--orange); color: #fff; }
  .h-btn-accent::before { background: #fff; }
  .h-btn-accent:hover, .h-btn-accent:focus-visible { color: var(--navy); }
  .h-btn-ghost { color: #eef1f6; box-shadow: inset 0 0 0 1px rgba(238, 241, 246, 0.5); }
  .h-btn-ghost::before { background: #eef1f6; }
  .h-btn-ghost:hover, .h-btn-ghost:focus-visible { color: var(--navy); }

  @keyframes h-rise { to { transform: none; } }
  @keyframes h-fade { to { opacity: 1; } }
  @keyframes h-drift { from { transform: translate3d(-1.2%, 0, 0); } to { transform: translate3d(1.2%, -0.8%, 0); } }
  @keyframes h-scroll { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }
  @keyframes h-float { from { transform: translateY(-6px); } to { transform: translateY(6px); } }

  @media (max-width: 768px) {
    :global(html.js) .h { height: 300vh; }
    .h-half { width: 80vw; }
    .h-plane { width: 130vw; top: 46%; }
    .h-word { flex-direction: column; gap: 0; font-size: 17vw; }
    .h-word .h-w:last-child { font-size: 0.62em; }
    .h-part { width: 22vw; }
    .h-part-1 { left: 27%; top: 17%; }
    .h-part-2 { left: 73%; top: 17%; width: 19vw; }
    .h-part-3 { left: 27%; top: 31%; width: 14vw; }
    .h-part-4 { left: 73%; top: 31%; width: 17vw; }
    .h-part-5 { left: 27%; top: 45%; width: 10vw; }
    .h-part-6 { left: 73%; top: 45%; width: 10vw; }
    .h-lead { display: none; }
    .h-label { white-space: normal; font-size: 11px; }
    .h-label strong { font-size: 13px; }
    .h-label span { display: none; }
    .h-final { top: auto; bottom: 96px; width: calc(100vw - 32px); }
    .h-final h2 { font-size: 30px; }
    .h-stats { grid-template-columns: repeat(2, auto); gap: 8px 28px; margin-top: 14px; padding-top: 10px; }
    .h-cta { margin-top: 18px; }
    .h-btn { height: 46px; padding: 0 18px; font-size: 14px; }
    .h-line { top: 16%; right: 24px; }
    .p1 { width: 160vw; left: -30vw; }
    .p2 { width: 80vw; }
    .p3 { width: 90vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-ch { animation: none; transform: none; }
    .h-pvt, .h-tag { animation: none; opacity: 1; }
    .h-drift, .h-part-img, .h-scroll i::after { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
    const $$ = (s: string) => Array.from(hero.querySelectorAll<HTMLElement>(s));
    const plane = $('[data-plane]');
    const parts = $$('[data-part]');
    const final = $('[data-final]');
    const mobile = () => window.innerWidth <= 768;

    // Vector from a part's resting spot to its anchor point on the plane (plane parked at centre).
    const fromPlane = (el: HTMLElement, axis: 'x' | 'y') => {
      const stage = hero.firstElementChild as HTMLElement;
      const pw = plane.offsetWidth, ph = plane.offsetHeight;
      const px = stage.clientWidth / 2 - pw / 2 + pw * Number(el.dataset.ax);
      const py = plane.offsetTop - ph / 2 + ph * Number(el.dataset.ay);
      return axis === 'x' ? px - el.offsetLeft : py - el.offsetTop;
    };

    gsap.set(plane, { xPercent: -50, yPercent: -50 });
    gsap.set(parts, { xPercent: -50, yPercent: -50, x: 0, y: 0 });
    gsap.set(final, { xPercent: -50, yPercent: () => (mobile() ? 0 : -50) });

    const tl = gsap.timeline({ defaults: { ease: 'none' }, paused: true });

    // 10–30%: the clouds open; the title lifts away.
    $$('[data-wall]').forEach((half) => {
      const dir = Number(half.dataset.wall);
      tl.to(half, { xPercent: dir * 115, scale: 1.3, ease: 'power2.in', duration: 20 }, 10);
    });
    tl.to($$('[data-blur]'), { opacity: 1, duration: 12 }, 14)
      .to('[data-title]', { yPercent: -35, opacity: 0, ease: 'power1.in', duration: 14 }, 10)
      .fromTo($$('[data-puff]'), { y: 0 }, { y: (i, el) => -window.innerHeight * 0.18 * Number(el.dataset.puff), duration: 90 }, 10)
      .fromTo($$('.h-puffs-far .h-puff'), { x: 0 }, { x: (i) => (i ? 1 : -1) * window.innerWidth * 0.06, duration: 90 }, 10);

    // 30–60%: the aircraft crosses from the right to the centre.
    tl.fromTo(plane, { x: () => window.innerWidth * 1.1, y: () => window.innerHeight * 0.06, rotation: -3 },
        { x: 0, y: 0, rotation: -1, ease: 'power2.out', duration: 30 }, 30)
      .to('[data-trail]', { scaleX: 1, ease: 'power1.out', duration: 26 }, 32)
      .to('[data-line]', { opacity: 1, y: -12, duration: 8 }, 36)
      .to('.h-puffs-near', { x: () => -window.innerWidth * 0.25, duration: 50 }, 30);

    // 60–85%: the split. The sky dims, parts leave their points on the plane.
    tl.to('[data-line]', { opacity: 0, duration: 4 }, 58)
      .to('[data-dusk]', { opacity: 1, duration: 10 }, 60)
      .to('.h-puffs', { opacity: 0.25, duration: 10 }, 60)
      .to(plane, { opacity: 0.35, rotation: 0, duration: 8 }, 61)
      .to('[data-trail]', { opacity: 0, duration: 8 }, 61);
    parts.forEach((p, i) => {
      const at = 63 + i * 1.6;
      tl.fromTo(p,
        { x: () => fromPlane(p, 'x'), y: () => fromPlane(p, 'y'), scale: 0.12, rotation: i % 2 ? 14 : -14, opacity: 0 },
        { x: 0, y: 0, scale: 1, rotation: 0, opacity: 1, ease: 'power3.out', duration: 12 }, at)
        .to(p.querySelector('[data-lead]'), { scaleY: 1, duration: 4 }, at + 9)
        .to(p.querySelector('[data-label]'), { opacity: 1, duration: 4 }, at + 11);
    });

    // 85–100%: the plane leaves; the headline lands.
    tl.to(plane, { x: () => -window.innerWidth * 0.9, opacity: 0, ease: 'power2.in', duration: 11 }, 86)
      .to(final, { autoAlpha: 1, duration: 7 }, 89)
      .fromTo(final.querySelector('h2'), { y: 24 }, { y: 0, ease: 'power3.out', duration: 8 }, 89)
      .set({}, {}, 100);

    if (reduce) {
      // Static composition: open sky, plane at centre, parts around it, every line of text visible.
      tl.progress(0.85);
      gsap.set(plane, { x: 0, opacity: 0.45 });
      gsap.set(final, { autoAlpha: 1 });
      hero.style.height = 'auto';
    } else {
      const lenis = new Lenis({ lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);

      ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1,
        animation: tl,
        invalidateOnRefresh: true,
        onUpdate: (st) => hero.classList.toggle('h-settled', st.progress > 0.86),
      });
    }
  }
</script>
