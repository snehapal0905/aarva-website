---
// Technical-drawing style illustrations of the parts AARVA makes.
// Used instead of stock photos until real shop-floor and part photos are available.
import type { PartKind } from '../data/site';

interface Props {
  kind: PartKind;
  label?: string;
  class?: string;
}
const { kind, label, class: className } = Astro.props;

function gearPath(cx: number, cy: number, rOuter: number, rRoot: number, teeth: number) {
  const pts: string[] = [];
  const step = (Math.PI * 2) / teeth;
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    const corners = [
      [rRoot, a],
      [rOuter, a + step * 0.18],
      [rOuter, a + step * 0.5],
      [rRoot, a + step * 0.68],
    ];
    for (const [r, t] of corners) pts.push(`${(cx + r * Math.cos(t)).toFixed(1)},${(cy + r * Math.sin(t)).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
}
---
<svg class:list={['bp', className]} viewBox="0 0 240 170" fill="none" role="img" aria-label={label ?? `${kind} drawing`}>
  {kind === 'gear' && (
    <g>
      <path class="bp-line" d={gearPath(92, 82, 58, 48, 16)} />
