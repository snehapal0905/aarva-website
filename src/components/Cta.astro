---
import { Image } from 'astro:assets';
import clouds from '../assets/site/cta-clouds.jpg';
import { cta } from '../data/content';
interface Props {
  title?: string;
  text?: string;
}
const { title = cta.title, text = cta.text } = Astro.props;
---
<section class="section-tight">
  <div class="container">
    <div class="cta-photo reveal">
      <Image src={clouds} alt="" widths={[960, 1800]} sizes="(max-width: 1200px) 100vw, 1200px" />
      <span class="eyebrow">{cta.eyebrow}</span>
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="hero-cta" style="margin-top:28px">
        <a href="/contact/#rfq" class="btn btn-light">Request a Quote</a>
        <a href="/capabilities/" class="btn btn-ghost">View Capabilities</a>
      </div>
    </div>
  </div>
</section>
