---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const waLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hello Aarva Aerospace, I would like a quote for machined components.')}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  telephone: site.phone,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  description: 'Precision CNC and 5-axis VMC machining for aerospace, defence, medical, automotive and hydraulics. ISO 9001:2015 certified, Peenya, Bengaluru.',
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.isPreview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#05070d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label={`${site.name} home`}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="nav-actions">
          <a href="/catalogue/" class="btn btn-ghost btn-sm hide-sm">Catalogue</a>
          <a href="/contact/#rfq" class="btn btn-light btn-sm">Request a quote</a>
          <button class="menu-btn" aria-label="Open menu" aria-expanded="false" data-menu-btn>
            <span></span><span></span>
          </button>
        </div>
      </div>
      <div class="mobile-menu" data-menu>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/catalogue/">Catalogue</a>
        <a href="/contact/#rfq">Request a quote</a>
        <a href={site.phoneHref} class="mobile-phone">{site.phone}</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>{site.name}</span>
          </a>
          <p class="muted">
            Precision CNC &amp; VMC machined components for aerospace, defence and industry.
          </p>
          <p class="badges">
            <span>ISO 9001:2015 certified</span>
            <span>MSME registered</span>
            <span>GST registered</span>
          </p>
        </div>
        <div>
          <h3 class="footer-h">Company</h3>
          <ul class="footer-list">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href="/catalogue/">Catalogue</a></li>
          </ul>
        </div>
        <div>
          <h3 class="footer-h">Contact</h3>
          <ul class="footer-list">
            <li><a href={site.phoneHref}>{site.phone}</a></li>
            <li><a href={waLink} target="_blank" rel="noopener">WhatsApp</a></li>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
            <li class="muted">{site.address.line1}, {site.address.city} – {site.address.postalCode}</li>
          </ul>
        </div>
      </div>
      <div class="container footer-base">
        <span>© {site.founded} {site.legalName} All rights reserved.</span>
        <span class="mono">CIN {site.cin}</span>
      </div>
    </footer>

    <a class="wa-float" href={waLink} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91A9.86 9.86 0 0 0 12.04 2Zm5.8 14.02c-.24.68-1.42 1.3-1.95 1.35-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.92-4.66-4.1-.13-.18-1.11-1.48-1.11-2.83 0-1.34.7-2 .95-2.28.25-.27.54-.34.72-.34h.52c.17 0 .39-.06.61.47.24.56.79 1.92.86 2.06.07.14.11.3.02.48-.09.18-.14.3-.27.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.52 1.89 1.05.93 1.93 1.22 2.2 1.36.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.33Z"/></svg>
    </a>

    {site.isPreview && <div class="preview-ribbon">Design preview by Sneha Pal</div>}

    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const header = document.querySelector<HTMLElement>('[data-nav]');
      btn?.addEventListener('click', () => {
        const open = header?.classList.toggle('open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
      });
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
