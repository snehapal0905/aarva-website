---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you are looking for does not exist.">
  <section class="hero" style="padding-bottom:120px">
    <div class="container">
      <span class="pill"><b>404</b> Page not found</span>
      <h1>Out of tolerance</h1>
      <p class="hero-sub">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="hero-cta">
        <a href="/" class="btn btn-light">Back to home</a>
        <a href="/contact/#rfq" class="btn btn-ghost">Request a quote</a>
      </div>
    </div>
  </section>
</Base>
