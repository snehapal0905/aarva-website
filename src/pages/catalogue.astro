---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import p1 from '../assets/site/parts-1.jpg';
import p2 from '../assets/site/parts-2.jpg';
import p3 from '../assets/site/finish-anodized.jpg';
const imgs = [p2, p1, p2, p1, p3, p2];
import Cta from '../components/Cta.astro';
import { componentExamples } from '../data/site';
---
<Base
  title="Catalogue: Precision Machined Parts"
  description="Examples of precision machined components from Aarva Aerospace: aerospace brackets, housings, mounting blocks, valve bodies, spacers and fixture plates."
>
  <PageHero
    eyebrow="Catalogue"
    title="Parts we manufacture"
    text="A selection of components across aluminium, steel and brass, with finishes including bead blasting and anodizing. Need something else? Send us your drawing."
  />

  <section class="section-tight">
    <div class="container grid-3">
      {componentExamples.map((c, i) => (
        <article class="img-card reveal">
          <div class="art"><Image src={imgs[i % imgs.length]} alt="" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 33vw" /></div>
          <div class="body">
            <div class="meta"><span>{c.industry}</span><span class="mono">{c.material}</span></div>
            <h3 style="margin-top:10px">{c.component}</h3>
            <p>{c.process}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Cta title="Don’t see your part? Send the drawing." />
</Base>
